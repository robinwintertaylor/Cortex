#!/usr/bin/env bash
# brain — thin shell wrapper over the Cortex REST API (Plan 2 §9.4).
# Used by the DSH bash tool, headless wrappers, and humans.
#
# Credentials resolve in this order:
#   1. CORTEX_KEY env                    (cx-<agent-id>-<secret>)
#   2. key file: CORTEX_KEY_FILE env or ~/.config/cortex/agent-keys.key
#      (one "agent-id=cx-…" per line, # comments; CORTEX_AGENT picks the
#       id, default "dsh" — set CORTEX_AGENT on machines wired as another
#       harness)
#   3. a single bare key line (no "id=" prefix) in the key file
#   plus CORTEX_URL (default http://localhost:8738)
#
#   brain context [project]
#   brain search <query...>
#   brain recent [since] [limit]
#   brain digest [since]
#   brain read <id>
#   brain log-action <summary> [--outcome ...] [--project ...] [--files a,b]
#   brain log-decision <title> --choice ... --options a,b,c [--rationale ...] [--project ...]
#   brain lesson <statement...> [--project ...] [--verified-by ...]
#   brain note <title> --body ... [--tags a,b] [--project ...]
#   brain capture <url> [--note ...]
#   brain entities [query]
#   brain facts-about <entity>
#   brain queue                          # list open items
#   brain queue-add <title> [--project ...]
#   brain queue-claim <item_id>
#   brain queue-complete <item_id>
#   brain agents
set -euo pipefail

CORTEX_URL="${CORTEX_URL:-http://localhost:8738}"

if [[ -z "${CORTEX_KEY:-}" ]]; then
  KEY_FILE="${CORTEX_KEY_FILE:-$HOME/.config/cortex/agent-keys.key}"
  if [[ -r "$KEY_FILE" ]]; then
    AGENT_ID="${CORTEX_AGENT:-dsh}"
    while IFS= read -r line; do
      [[ -z "${line// }" || "$line" == \#* ]] && continue
      if [[ "$line" == *=cx-* ]]; then
        k_id="${line%%=*}"
        if [[ "$k_id" == "$AGENT_ID" ]]; then CORTEX_KEY="${line#*=}"; break; fi
      elif [[ "$line" == cx-* ]]; then
        CORTEX_KEY="$line"   # bare-key file
        break
      fi
    done < "$KEY_FILE"
  fi
fi
CORTEX_KEY="${CORTEX_KEY:?set CORTEX_KEY, or create a key file at ~/.config/cortex/agent-keys.key (lines: agent-id=cx-…; CORTEX_AGENT selects the id, default dsh)}"
cmd="${1:-help}"; shift || true

api() { # api METHOD PATH [json]
  local method="$1" path="$2" body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -sf -X "$method" -H "Authorization: Bearer $CORTEX_KEY" \
      -H "Content-Type: application/json" -d "$body" "$CORTEX_URL$path"
  else
    curl -sf -X "$method" -H "Authorization: Bearer $CORTEX_KEY" "$CORTEX_URL$path"
  fi
}

json_escape() { python3 -c 'import json,sys; print(json.dumps(" ".join(sys.argv[1:])))' "$@"; }

case "$cmd" in
  context)   api GET "/v1/brain_context${1:+?project=$1}" ;;
  search)    api GET "/v1/brain_search?q=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(" ".join(sys.argv[1:])))' "$@")&limit=8" ;;
  recent)    api GET "/v1/brain_recent?since=${1:-24h}&limit=${2:-20}" ;;
  digest)    api GET "/v1/brain_digest?since=${1:-48h}" ;;
  read)      api GET "/v1/brain_read/$1" ;;
  log-action)
    summary="$(json_escape "$1")"; shift
    outcome=""; project=""; files="[]"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --outcome) outcome="$2"; shift 2 ;;
        --project) project="$2"; shift 2 ;;
        --files)   files="[\"$(echo "$2" | tr ',' '","')\"]"; shift 2 ;;
        *) shift ;;
      esac
    done
    api POST /v1/brain_log_action "{\"summary\":$summary,\"outcome\":\"$outcome\",\"project\":\"$project\",\"files\":$files}" ;;
  log-decision)
    title="$(json_escape "$1")"; shift
    choice=""; options="[]"; rationale=""; project=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --choice)   choice="$2"; shift 2 ;;
        --options)  options="[\"$(echo "$2" | tr ',' '","')\"]"; shift 2 ;;
        --rationale) rationale="$(json_escape "$2")"; shift 2 ;;
        --project)  project="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    api POST /v1/brain_log_decision "{\"title\":$title,\"options\":$options,\"choice\":\"$choice\",\"rationale\":$rationale,\"project\":\"$project\"}" ;;
  lesson)
    statement="$(json_escape "$1")"; shift
    project=""; verified=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --project)    project="$2"; shift 2 ;;
        --verified-by) verified="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    api POST /v1/brain_lesson "{\"statement\":$statement,\"verified_by\":\"$verified\",\"project\":\"$project\"}" ;;
  note)
    title="$(json_escape "$1")"; shift
    body=""; tags="[]"; project=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --body)   body="$(json_escape "$2")"; shift 2 ;;
        --tags)   tags="[\"$(echo "$2" | tr ',' '","')\"]"; shift 2 ;;
        --project) project="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    api POST /v1/brain_note "{\"title\":$title,\"body\":$body,\"tags\":$tags,\"project\":\"$project\"}" ;;
  capture)
    url="$1"; note=""; shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --note) note="$(json_escape "$2")"; shift 2 ;;
        *) shift ;;
      esac
    done
    api POST /v1/brain_capture_url "{\"url\":\"$url\",\"note\":$note}" ;;
  entities)  api GET "/v1/brain_entities${1:+?query=$1}" ;;
  facts-about) api GET "/v1/brain_facts_about?entity=$1" ;;
  queue)     api GET "/v1/brain_queue" ;;
  queue-add) api POST /v1/brain_queue_add "{\"title\":\"$1\",\"project\":\"${2:-}\"}" ;;
  queue-claim)   api POST /v1/brain_queue_claim "{\"item_id\":\"$1\"}" ;;
  queue-complete) api POST /v1/brain_queue_complete "{\"item_id\":\"$1\"}" ;;
  agents)    api GET /v1/brain_agents ;;
  health)    api GET /healthz ;;
  help|-h|--help|*) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
echo
