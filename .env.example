# ── Cortex configuration ────────────────────────────────────────────────────
# Copy to .env and adjust. Defaults are safe for a single LAN box.

# Postgres (pgvector/pgvector:pg16 image in docker-compose)
DATABASE_URL=postgres://cortex:cortex@db:5432/cortex

# Bootstrap admin key. Used for agent/key management via CLI or API.
# Generate with: python -c "import secrets; print('cx-admin-' + secrets.token_urlsafe(24))"
CORTEX_ADMIN_KEY=change-me

# Shared token for hook sinks (/hook/*) — Claude Code HTTP hooks etc.
CORTEX_HOOK_TOKEN=change-me-too

# ── LLM extraction (OPTIONAL — disabled until configured) ───────────────────
# Any OpenAI-compatible endpoint: DeepSeek API, local ollama, OpenRouter...
#   DeepSeek:    https://api.deepseek.com/v1    model: deepseek-chat
#   ollama:      http://lan-box:11434/v1        model: gemma3:12b (data stays on LAN)
#   LM Studio:   http://host.docker.internal:1234/v1 (run on this device, enable
#                'Serve on Local Network'; model = the id LM Studio shows)
#   OpenRouter:  https://openrouter.ai/api/v1   model: <provider>/<model>:free
# Leave CORTEX_LLM_BASE_URL empty to disable extraction (raw events stay
# fully functional: append + FTS search + digest all work without it).
# Privacy note: any remote endpoint receives your event contents (agent
# actions, file paths, research text). ollama/LM Studio keep that on your LAN.
CORTEX_LLM_BASE_URL=
CORTEX_LLM_API_KEY=
CORTEX_LLM_MODEL=deepseek-chat
# Some providers/models (OpenRouter free tiers, and LM Studio's llama.cpp
# backend) reject OpenAI's response_format json_object outright. Cortex
# parses defensively without it, so set this to false if the provider
# errors on extraction calls.
CORTEX_LLM_JSON_MODE=true
# 60s suits hosted APIs. A local model — especially a reasoning model on
# modest hardware — can take minutes per call with no visible progress in
# between; raise this rather than let calls fail on timeout.
CORTEX_LLM_TIMEOUT_SECONDS=60

# ── Embeddings (local ONNX via fastembed) ───────────────────────────────────
# Must match the vector column dimension baked into the schema at first boot.
# BAAI/bge-m3 = 1024 dims (PRD default). fastembed 0.8 no longer ships m3 on
# TextEmbedding; Cortex falls back to BAAI/bge-large-en-v1.5 (also 1024).
# Fallback: BAAI/bge-base-en-v1.5 (768) — only if you recreate the volume.
CORTEX_EMBED_MODEL=BAAI/bge-m3
CORTEX_EMBED_DIM=1024

# Optional cross-encoder rerank (P1, off by default; enable per-call mode="rerank")
CORTEX_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CORTEX_RERANK_ENABLED=false

# ── Service bind ────────────────────────────────────────────────────────────
CORTEX_HOST=0.0.0.0
CORTEX_PORT=8738
DASHBOARD_PORT=8740

# ── Research capture (FR-11) ────────────────────────────────────────────────
CORTEX_CAPTURE_TIMEOUT=15
CORTEX_CAPTURE_MAX_BYTES=5242880

# ── File uploads (brain_upload_file, every harness) ─────────────────────────
# CORTEX_FILES_DIR defaults to /data/files inside the container (the
# `filedata` docker volume) — only change this for a bare-metal install.
CORTEX_UPLOAD_MAX_BYTES=20971520

# ── Digest / context sizing ─────────────────────────────────────────────────
CORTEX_CONTEXT_MAX_BYTES=25600

# ── Misc ────────────────────────────────────────────────────────────────────
CORTEX_LOG_LEVEL=INFO
# LAN CIDRs allowed to call hook sinks (comma-separated). Empty = private ranges only.
CORTEX_LAN_CIDRS=
